generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userID Int @default(autoincrement()) @id 
  name String
  email String @unique
  password String
  icon String?
  permission String @default("ALUNO")
  Classes Classes[]
  Teacher Teacher? 

  @@map("User")
}

model Teacher {
  teacherID Int @default(autoincrement()) @id
  userID Int @unique
  User User @relation(fields: [userID], references: [userID])
  Classes Classes[]

  @@map("Teacher")
}

model Classes{
  classesUUID String @default(uuid()) @db.Uuid @unique @id
  title String
  description String
  imageUrl String
  Teacher Teacher[]
  User User[]

  @@map("Classes")
}
