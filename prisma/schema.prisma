// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userID Int @default(autoincrement()) @id 
  name String
  email String @unique
  password String
  icon String?
  Teacher Teacher? 
  Student Student?
  Admin Admin?

  @@map("User")
}

model Teacher {
  teacherID Int @default(autoincrement()) @id
  userID Int @unique
  User User @relation(fields: [userID], references: [userID])
  Classes Classes[]

  @@map("Teacher")
}

model Student {
  studentID Int @default(autoincrement()) @id
  userID Int @unique
  User User @relation(fields: [userID], references: [userID])
  Classes Classes[]

  @@map("Student")
}

model Admin {
  adminID Int @default(autoincrement()) @id
  userID Int @unique
  User User @relation(fields: [userID], references: [userID])

  @@map("Admin")
}

model Classes{
  classesUUID String @default(uuid()) @db.Uuid @unique @id
  title String
  description String
  imageUrl String
  LevelID Int
  LanguegeID Int
  ClassLevel  ClassLevel @relation(fields: [LevelID], references: [LevelID])
  Languege Languege @relation(fields: [LanguegeID], references: [LanguegeID])
  Teacher Teacher[]
  Student Student[]

  @@map("Classes")
}

model Languege{
  LanguegeID Int @default(autoincrement()) @id
  LanguegeName String
  Classes Classes[]

  @@map("languege")
}

model ClassLevel{
  LevelID Int @default(autoincrement()) @id
  LevelName String
  Classes Classes[]

  @@map("Level")
}